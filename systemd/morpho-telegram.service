[Unit]
Description=Morpho Telegram Ops Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=root
WorkingDirectory=/root/morpho-agents

ExecStart=/root/morpho-agents/venv/bin/python /root/morpho-agents/telegram_interface.py

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
